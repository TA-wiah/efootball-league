# eFootball Champions League settings.
# Copy this file to ".env" (same folder as server.js) and fill in what you need.
# Lines starting with # are ignored. Never commit or share your real .env – it holds passwords.

# ---------- Server ----------
PORT=3000
# Public address of the site (no trailing slash). Needed for emailed links and "Forgot password".
# APP_URL=https://league.example.com
# Set to 1 when the site runs behind a proxy/host (Railway, Render, Fly, Caddy, Nginx). Leave it out otherwise.
# TRUST_PROXY=1
# Force Secure cookies even without APP_URL (normally automatic over https).
# COOKIE_SECURE=1

# ---------- Data ----------
# Where the database lives (default: data/league.db next to server.js).
# DB_FILE=/data/league.db
# Where daily backups go (default: a "backups" folder next to the database).
# BACKUP_DIR=/data/backups

# ---------- First admin / password reset ----------
# The account is created (or its password reset) when the server starts with these set.
# After you can log in, REMOVE ADMIN_PASSWORD from this file and change the password in the Admins tab.
ADMIN_USER=boss
# ADMIN_PASSWORD=choose a long password (10+ characters)
# ADMIN_EMAIL=you@example.com

# ---------- Email (SMTP) for invites and password resets ----------
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your Gmail, SMTP_PASS=an App Password (not your normal one).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=league@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# SMTP_FROM=eFootball League <league@gmail.com>
# 465 uses TLS straight away; 587 upgrades with STARTTLS. Only set this to override the guess from the port.
# SMTP_SECURE=1
# Starting league for a new database (default: seed.json next to server.js)
# SEED_FILE=/data/seed.json
